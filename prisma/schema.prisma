// Nice & Neat — Barber Shop Management System
// Schema designed for service-based business with inventory, expenses, cash flow

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// SHOP PROFILE
// ============================================

model Shop {
  id              String   @id @default(cuid())
  name            String   @default("Nice & Neat")
  tagline         String?  // e.g. "Premium Barber Shop"
  phone           String?
  email           String?
  address         String?
  location        String?  // e.g. "Westlands, Nairobi"
  currency        String   @default("KES")
  language        String   @default("en")
  ownerName       String?
  receiptFooter   String?  @default("Thank you for choosing Nice & Neat!")
  taxRate         Float    @default(0)   // Service tax % if applicable
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services    Service[]
  products    Product[]
  clients     Client[]
  barbers     Barber[]
  sales       Sale[]
  expenses    Expense[]
  suppliers   Supplier[]
}

// ============================================
// SERVICES (Haircut, Shave, Fade, etc.)
// ============================================

model Service {
  id            String   @id @default(cuid())
  shopId        String
  name          String                    // e.g. "Classic Haircut", "Skin Fade", "Beard Trim"
  category      String   @default("Haircut") // Haircut | Shave | Beard | Kids | Style | Other
  price         Float                     // Standard price
  duration      Int      @default(30)     // Estimated minutes
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
}

// ============================================
// RETAIL PRODUCTS (Pomade, Gel, Shampoo, etc.)
// ============================================

model Product {
  id            String   @id @default(cuid())
  shopId        String
  name          String                    // e.g. "Suavecito Pomade", "Beard Oil"
  category      String   @default("Styling") // Styling | Grooming | Aftercare | Supply
  price         Float                     // Selling price
  costPrice     Float    @default(0)      // Purchase cost
  quantity      Int      @default(0)      // Stock on hand
  reorderLevel  Int      @default(5)      // Low stock alert
  unit          String   @default("pcs")  // pcs | bottle | tube
  supplierId    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
}

// ============================================
// CLIENTS (Customer history & loyalty)
// ============================================

model Client {
  id            String   @id @default(cuid())
  shopId        String
  name          String
  phone         String?
  email         String?
  notes         String?                   // Preferences: "Likes skin fade, no clippers on sides"
  loyaltyPoints Int      @default(0)      // 1 point per visit
  totalVisits   Int      @default(0)
  totalSpent    Float    @default(0)
  lastVisitAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop     @relation(fields: [shopId], references: [id])
  sales         Sale[]

  @@index([shopId])
  @@index([shopId, phone])
}

// ============================================
// BARBERS (Staff with commission tracking)
// ============================================

model Barber {
  id              String   @id @default(cuid())
  shopId          String
  name            String
  phone           String?
  role            String   @default("barber") // owner | barber | apprentice
  commissionType  String   @default("percentage") // percentage | flat | booth_rental
  commissionValue Float    @default(60)  // 60 = 60% of service revenue, or flat KES amount
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop            Shop     @relation(fields: [shopId], references: [id])
  sales           Sale[]

  @@index([shopId])
}

// ============================================
// SALES (Transactions — services + retail)
// ============================================

model Sale {
  id            String   @id @default(cuid())
  shopId        String
  clientId      String?
  barberId      String?
  invoiceNumber String                    // e.g. NN-20250105-001
  subtotal      Float                     // Before tax
  taxAmount     Float    @default(0)
  discountAmount Float   @default(0)
  totalAmount   Float                     // Final amount paid
  paymentMethod String   @default("cash") // cash | mpesa | card
  mpesaRef      String?                   // M-Pesa transaction code
  status        String   @default("completed") // completed | refunded
  notes         String?
  saleDate      DateTime @default(now())  // When the sale happened
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop     @relation(fields: [shopId], references: [id])
  client        Client?  @relation(fields: [clientId], references: [id])
  barber        Barber?  @relation(fields: [barberId], references: [id])
  items         SaleItem[]

  @@index([shopId, saleDate])
  @@index([shopId, paymentMethod])
  @@index([shopId, status])
}

model SaleItem {
  id            String   @id @default(cuid())
  saleId        String
  itemType      String                     // service | product
  itemId        String                     // Service ID or Product ID
  itemName      String                     // Snapshot of name at time of sale
  price         Float                      // Unit price
  quantity      Int      @default(1)
  lineTotal     Float                      // price * quantity
  createdAt     DateTime @default(now())

  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ============================================
// EXPENSES (Rent, Utilities, Supplies, Salaries, etc.)
// ============================================

model Expense {
  id            String   @id @default(cuid())
  shopId        String
  category      String                     // rent | utilities | supplies | salaries | inventory | maintenance | marketing | misc
  description   String                     // e.g. "Monthly rent - January", "Electricity bill", "Clipper blades x10"
  amount        Float
  paymentMethod String   @default("cash")  // cash | mpesa | bank
  vendor        String?                    // Who was paid
  expenseDate   DateTime                   // When the expense was incurred
  isRecurring   Boolean  @default(false)   // Monthly recurring expense
  recurringType String?                    // monthly | weekly | daily
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, expenseDate])
  @@index([shopId, category])
}

// ============================================
// SUPPLIERS (For inventory restocking)
// ============================================

model Supplier {
  id            String   @id @default(cuid())
  shopId        String
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
}
